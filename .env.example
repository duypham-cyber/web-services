# Mẫu biến môi trường — chép thành .env.local (KHÔNG commit .env.local).
# Trang tĩnh được dựng lúc build: đổi biến nào dưới đây thì phải build lại.

# --- Bắt buộc ---------------------------------------------------------------
# Địa chỉ gốc của site (canonical, og:image, sitemap). Không có dấu / ở cuối.
SITE_URL=https://ten-mien-cua-ban.vn

# --- Tuỳ chọn ---------------------------------------------------------------
# 1 = bản staging/trưng bày: thêm X-Robots-Tag noindex để Google không lập chỉ mục.
STAGING=1
# 1 = bản nháp nội bộ: hiện nội dung chưa duyệt kèm nhãn "Nháp". Bản cho khách xem thì để trống.
DRAFT_PREVIEW=
# 1 = giữ trang /dev/* (thư viện giao diện) trong bản production.
DEV_PAGES=

# --- Form liên hệ / đăng ký thợ (lead) ----------------------------------------
# Tắt mặc định: form cần PostgreSQL + Cloudflare Turnstile + SMTP. Muốn bật, đọc docs/LEADS-RUNBOOK.md
# (đủ danh sách biến, cách tạo DB, migration, checklist trước khi mở).
LEADS_FORM_ENABLED=false
# DATABASE_URL=postgres://bb_app:<mat-khau>@127.0.0.1:5432/bluebolt_web
# LEAD_IP_HASH_SECRET=<64 ký tự hex ngẫu nhiên>
# LEAD_ALLOWED_ORIGINS=https://ten-mien-cua-ban.vn
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key Cloudflare Turnstile>
# TURNSTILE_SECRET_KEY=<secret key Cloudflare Turnstile>
# TURNSTILE_ALLOWED_HOSTNAMES=ten-mien-cua-ban.vn
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Bluebolt Website <leads@ten-mien-cua-ban.vn>
# LEAD_NOTIFY_EMAIL_B2B=
# LEAD_NOTIFY_EMAIL_TECHNICIAN=
