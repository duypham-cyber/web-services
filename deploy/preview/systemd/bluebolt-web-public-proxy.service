[Unit]
StartLimitIntervalSec=0
Description=bluebolt-web — proxy cong khai cong 9515 (Tailscale) -> localhost:3092, khong mat khau, noindex (services.bluebolt.software, D-30)
After=bluebolt-web-public.service
Wants=bluebolt-web-public.service

[Service]
WorkingDirectory=/home/bbsw/WorkspaceDuy/LapDatToanQuoc/bluebolt-web
EnvironmentFile=/home/bbsw/WorkspaceDuy/LapDatToanQuoc/bluebolt-web/.env.public
ExecStart=/usr/bin/node deploy/preview/proxy.mjs
