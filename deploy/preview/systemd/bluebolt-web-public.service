[Unit]
Description=bluebolt-web — ban trung bay cong khai (next start, localhost:3092, .next-public, production + STAGING noindex, D-30)
After=network.target

[Service]
WorkingDirectory=/home/bbsw/WorkspaceDuy/LapDatToanQuoc/bluebolt-web
EnvironmentFile=/home/bbsw/WorkspaceDuy/LapDatToanQuoc/bluebolt-web/.env.public
Environment=NEXT_DIST_DIR=.next-public
Environment=PORT=3092
Environment=STAGING=1
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
MemoryMax=1200M

[Install]
WantedBy=default.target
