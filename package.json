{
  "name": "bluebolt-web",
  "version": "0.1.0",
  "private": true,
  "description": "Website Bluebolt Services (lapdattoanquoc.vn) — Next.js 16, phương án phim A+",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev -H localhost -p ${PORT:-3091}",
    "build": "next build",
    "start": "next start -H localhost -p ${PORT:-3092}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:overflow": "playwright test tests/overflow.spec.ts",
    "test:seo": "playwright test tests/seo-render.spec.ts tests/seo/",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:map": "playwright test tests/map --project=desktop-1440",
    "shot": "node scripts/shot.mjs",
    "map:gen": "node scripts/make-map.mjs",
    "map:check": "node scripts/make-map.mjs --check",
    "seo:og": "node scripts/gen-og-images.mjs",
    "redirects:gen": "node scripts/gen-openresty-map.mjs",
    "redirects:check": "node scripts/check-redirects.mjs",
    "check:draft": "node scripts/check-no-draft.mjs",
    "budget": "node -e \"console.log('[budget] CHUA KIEM GI: agent QA se viet scripts/check-budgets.mjs + budgets.json theo docs/04 muc 3.3 va 7.1.')\""
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "d3-geo": "3.1.1",
    "detect-gpu": "5.0.70",
    "gsap": "3.15.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "3.1.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.62.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
